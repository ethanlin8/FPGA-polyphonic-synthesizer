# ==============================================================================
# 1. Vivado Local Build & Autogenerated Artifacts
#    (Human-written RTL & constraints live in hw/ and ip_repo/)
# ==============================================================================
build/
*.xpr
*.srcs/
*.jou
*.log
*.str
*.dmp
*.pb
*.wdb
*.wcfg
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/

# Ignore binary Block Design files & accidental bd folders inside hw/
# (Block Design is recreated automatically via scripts/recreate.tcl)
*.bd
*.bda
*.bxml
hw/**/bd/

# Ignore generated bitstreams and checkpoints (bitstream is bundled inside export/*.xsa)
*.bit
*.bin
*.dcp
*.ltx

# ==============================================================================
# 2. Custom IP Packaging Temp Files
#    (Keep component.xml, hdl/, xgui/, and drivers/ tracked inside ip_repo/)
# ==============================================================================
ip_repo/**/xgui/*.log
ip_repo/**/*.jou
ip_repo/**/*.log
ip_repo/**/.Xil/
ip_repo/**/tmp_edit_project*

# ==============================================================================
# 3. Vitis 2022.2 Workspace & Build Artifacts
#    (Human-written C/C++ code lives in sw/src/; hardware handoff in export/*.xsa)
# ==============================================================================
sw/workspace/
.metadata/
.analytics/
RemoteSystemsTempFiles/
_ide/
Debug/
Release/
*.elf
*.o
*.d
*.a
*.bif
*.smi
*.mmi

# ==============================================================================
# 4. Operating System & Editor Files (macOS, Windows, VS Code, EWS Linux)
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux / EWS Network Filesystem Lock Files
.nfs*

# VS Code / Vim / General
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~